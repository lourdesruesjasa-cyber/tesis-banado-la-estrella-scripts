// -----------------------------------------------------
// 1. Área de estudio
// -----------------------------------------------------

var roi = table;

Map.centerObject(roi, 11);

Map.addLayer(
  roi,
  {color: 'orange'},
  'Área de estudio - BLE'
);


// -----------------------------------------------------
// 2. Parámetros
// -----------------------------------------------------

var escala = 10;

// Umbrales VH a evaluar
var umbralesVH = ee.List([-21, -22, -23, -24, -25]);


// -----------------------------------------------------
// 3. Cargar Sentinel-1 GRD
// -----------------------------------------------------

var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(roi)
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .select(['VV', 'VH']);

print('Colección Sentinel-1 filtrada:', s1);
print('Cantidad total de imágenes:', s1.size());


// -----------------------------------------------------
// 4. Composite mensual
// -----------------------------------------------------

function compositeMensual(anio, mes) {
  var inicio = ee.Date.fromYMD(anio, mes, 1);
  var fin = inicio.advance(1, 'month');

  var coleccionMensual = s1.filterDate(inicio, fin);

  var composite = coleccionMensual
    .median()
    .clip(roi)
    .set('anio', anio)
    .set('mes', mes)
    .set('fecha', inicio.format('YYYY-MM'))
    .set('cantidad_imagenes', coleccionMensual.size());

  return composite;
}


// -----------------------------------------------------
// 5. Calcular área para un mes y umbral VH
// -----------------------------------------------------

function areaVH(anio, mes, umbralVH) {
  var composite = compositeMensual(anio, mes);

  var agua = composite
    .select('VH')
    .lt(ee.Number(umbralVH))
    .selfMask();

  var area = ee.Image.pixelArea()
    .updateMask(agua)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: roi,
      scale: escala,
      maxPixels: 1e13,
      tileScale: 4
    });

  var areaHa = ee.Number(area.get('area')).divide(10000);

  return ee.Feature(null, {
    'anio': anio,
    'mes': mes,
    'fecha': composite.get('fecha'),
    'cantidad_imagenes': composite.get('cantidad_imagenes'),
    'polarizacion': 'VH',
    'umbral_VH_dB': umbralVH,
    'area_agua_ha': areaHa
  });
}


// -----------------------------------------------------
// 6. Serie mensual por año y umbral
// -----------------------------------------------------

function serieVH(anio) {
  var meses = ee.List.sequence(1, 12);

  var features = umbralesVH.map(function(umbral) {
    umbral = ee.Number(umbral);

    var porMes = meses.map(function(mes) {
      mes = ee.Number(mes);
      return areaVH(anio, mes, umbral);
    });

    return porMes;
  }).flatten();

  return ee.FeatureCollection(features);
}

var vh_2019 = serieVH(2019);
var vh_2021 = serieVH(2021);

var vh_total = vh_2019.merge(vh_2021);

print('Resultados VH 2019:', vh_2019);
print('Resultados VH 2021:', vh_2021);
print('Resultados VH 2019 y 2021:', vh_total);


// -----------------------------------------------------
// 7. Gráfico exploratorio VH
// -----------------------------------------------------

var graficoVH = ui.Chart.feature.groups({
  features: vh_total,
  xProperty: 'mes',
  yProperty: 'area_agua_ha',
  seriesProperty: 'umbral_VH_dB'
})
.setChartType('LineChart')
.setOptions({
  title: 'Exploración de umbrales VH - Sentinel-1',
  hAxis: {
    title: 'Mes'
  },
  vAxis: {
    title: 'Área detectada como agua (ha)'
  },
  lineWidth: 2,
  pointSize: 4
});

print(graficoVH);


// -----------------------------------------------------
// 8. Visualización de casos representativos
// -----------------------------------------------------

function visualizarVH(anio, mes, nombre) {
  var composite = compositeMensual(anio, mes);

  Map.addLayer(
    composite.select('VH'),
    {min: -30, max: -5},
    'VH ' + nombre,
    false
  );

  // Capas para cada umbral
  umbralesVH.evaluate(function(listaUmbrales) {
    listaUmbrales.forEach(function(umbral) {
      var agua = composite
        .select('VH')
        .lt(umbral)
        .selfMask();

      Map.addLayer(
        agua,
        {palette: ['blue']},
        'Agua VH < ' + umbral + ' dB ' + nombre,
        false
      );
    });
  });
}

visualizarVH(2019, 1, 'enero 2019');
visualizarVH(2021, 3, 'marzo 2021');
visualizarVH(2021, 7, 'julio 2021');
visualizarVH(2021, 12, 'diciembre 2021');


// -----------------------------------------------------
// 9. Exportar tabla
// -----------------------------------------------------

Export.table.toDrive({
  collection: vh_total,
  description: 'exploracion_umbral_VH_S1_2019_2021',
  folder: 'GEE_TESIS_BLE',
  fileNamePrefix: 'exploracion_umbral_VH_S1_2019_2021',
  fileFormat: 'CSV',
  selectors: [
    'anio',
    'fecha',
    'mes',
    'cantidad_imagenes',
    'polarizacion',
    'umbral_VH_dB',
    'area_agua_ha'
  ]
});
