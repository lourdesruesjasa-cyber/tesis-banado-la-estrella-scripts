// -----------------------------------------------------
// 1. Área de estudio
// -----------------------------------------------------

var roi = table;

Map.centerObject(roi, 11);

Map.addLayer(
  roi,
  {color: 'orange'},
  'Área de estudio - BLE'
);

// -----------------------------------------------------
// 2. Cargar colección Sentinel-1 GRD
// -----------------------------------------------------

var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(roi)
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .select(['VV', 'VH']);

print('Colección Sentinel-1 filtrada:', s1);
print('Cantidad total de imágenes Sentinel-1:', s1.size());

// -----------------------------------------------------
// 3. Filtrar años seleccionados
// -----------------------------------------------------

var s1_2019 = s1.filterDate('2019-01-01', '2020-01-01');
var s1_2021 = s1.filterDate('2021-01-01', '2022-01-01');

print('Cantidad de imágenes 2019:', s1_2019.size());
print('Cantidad de imágenes 2021:', s1_2021.size());

// -----------------------------------------------------
// 4. Función para crear composites mensuales
// -----------------------------------------------------

function crearCompositesMensuales(anio) {
  var meses = ee.List.sequence(1, 12);

  var composites = meses.map(function(mes) {
    mes = ee.Number(mes);

    var inicio = ee.Date.fromYMD(anio, mes, 1);
    var fin = inicio.advance(1, 'month');

    var coleccionMensual = s1
      .filterDate(inicio, fin);

    var composite = coleccionMensual
      .median()
      .clip(roi)
      .set('anio', anio)
      .set('mes', mes)
      .set('fecha_inicio', inicio.format('YYYY-MM-dd'))
      .set('fecha_fin', fin.format('YYYY-MM-dd'))
      .set('cantidad_imagenes', coleccionMensual.size());

    return composite;
  });

  return ee.ImageCollection.fromImages(composites);
}

// -----------------------------------------------------
// 5. Crear composites mensuales 2019 y 2021
// -----------------------------------------------------

var composites_2019 = crearCompositesMensuales(2019);
var composites_2021 = crearCompositesMensuales(2021);

print('Composites mensuales 2019:', composites_2019);
print('Composites mensuales 2021:', composites_2021);

// -----------------------------------------------------
// 6. Visualizar composites de prueba
// -----------------------------------------------------

var comp_enero_2019 = ee.Image(
  composites_2019.filter(ee.Filter.eq('mes', 1)).first()
);

var comp_enero_2021 = ee.Image(
  composites_2021.filter(ee.Filter.eq('mes', 1)).first()
);

Map.addLayer(
  comp_enero_2019,
  {bands: ['VV'], min: -25, max: 0},
  'Composite enero 2019 - VV',
  false
);

Map.addLayer(
  comp_enero_2019,
  {bands: ['VH'], min: -30, max: -5},
  'Composite enero 2019 - VH',
  false
);

Map.addLayer(
  comp_enero_2021,
  {bands: ['VV'], min: -25, max: 0},
  'Composite enero 2021 - VV',
  true
);

Map.addLayer(
  comp_enero_2021,
  {bands: ['VH'], min: -30, max: -5},
  'Composite enero 2021 - VH',
  false
);

// -----------------------------------------------------
// 7. Revisar cantidad de imágenes por mes
// -----------------------------------------------------

function tablaCantidadMensual(composites, anio) {
  var tabla = composites.map(function(img) {
    return ee.Feature(null, {
      'anio': img.get('anio'),
      'mes': img.get('mes'),
      'cantidad_imagenes': img.get('cantidad_imagenes')
    });
  });

  print('Cantidad de imágenes por mes ' + anio, tabla);
}

tablaCantidadMensual(composites_2019, 2019);
tablaCantidadMensual(composites_2021, 2021);
