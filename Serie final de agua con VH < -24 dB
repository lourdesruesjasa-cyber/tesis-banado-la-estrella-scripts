// =====================================================
// TESIS BLE - Sentinel-1
// Script 13: Serie final de agua con VH < -24 dB
// Años: 2019 y 2021
// Autora: Lourdes Ruesjas Aebicher
// =====================================================


// -----------------------------------------------------
// 1. Área de estudio
// -----------------------------------------------------

var roi = table;

Map.centerObject(roi, 11);

Map.addLayer(
  roi,
  {color: 'orange'},
  'Área de estudio - BLE'
);


// -----------------------------------------------------
// 2. Parámetros
// -----------------------------------------------------

var umbralVH = -24;
var escala = 10;


// -----------------------------------------------------
// 3. Cargar Sentinel-1 GRD
// -----------------------------------------------------

var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(roi)
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .select(['VV', 'VH']);

print('Colección Sentinel-1 filtrada:', s1);
print('Cantidad total de imágenes Sentinel-1:', s1.size());


// -----------------------------------------------------
// 4. Función para composite mensual
// -----------------------------------------------------

function compositeMensual(anio, mes) {
  var inicio = ee.Date.fromYMD(anio, mes, 1);
  var fin = inicio.advance(1, 'month');

  var coleccionMensual = s1.filterDate(inicio, fin);

  var composite = coleccionMensual
    .median()
    .clip(roi)
    .set('anio', anio)
    .set('mes', mes)
    .set('fecha', inicio.format('YYYY-MM'))
    .set('cantidad_imagenes', coleccionMensual.size());

  return composite;
}


// -----------------------------------------------------
// 5. Función para calcular área mensual VH
// -----------------------------------------------------

function areaAguaVHMensual(anio, mes) {
  var composite = compositeMensual(anio, mes);

  var agua = composite
    .select('VH')
    .lt(umbralVH)
    .selfMask();

  var area = ee.Image.pixelArea()
    .updateMask(agua)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: roi,
      scale: escala,
      maxPixels: 1e13,
      tileScale: 4
    });

  var areaHa = ee.Number(area.get('area')).divide(10000);

  return ee.Feature(null, {
    'anio': anio,
    'fecha': composite.get('fecha'),
    'mes': mes,
    'cantidad_imagenes': composite.get('cantidad_imagenes'),
    'polarizacion': 'VH',
    'umbral_VH_dB': umbralVH,
    'area_agua_ha': areaHa
  });
}


// -----------------------------------------------------
// 6. Serie mensual por año
// -----------------------------------------------------

function serieAnualVH(anio) {
  var meses = ee.List.sequence(1, 12);

  var tabla = ee.FeatureCollection(
    meses.map(function(mes) {
      mes = ee.Number(mes);
      return areaAguaVHMensual(anio, mes);
    })
  );

  return tabla;
}

var serie_vh_2019 = serieAnualVH(2019);
var serie_vh_2021 = serieAnualVH(2021);

var serie_vh_total = serie_vh_2019.merge(serie_vh_2021);

print('Serie VH 2019:', serie_vh_2019);
print('Serie VH 2021:', serie_vh_2021);
print('Serie final VH 2019 y 2021:', serie_vh_total);

print(
  'Áreas VH 2019 enero-diciembre (ha):',
  serie_vh_2019.aggregate_array('area_agua_ha')
);

print(
  'Áreas VH 2021 enero-diciembre (ha):',
  serie_vh_2021.aggregate_array('area_agua_ha')
);

print(
  'Cantidad de imágenes 2019 enero-diciembre:',
  serie_vh_2019.aggregate_array('cantidad_imagenes')
);

print(
  'Cantidad de imágenes 2021 enero-diciembre:',
  serie_vh_2021.aggregate_array('cantidad_imagenes')
);


// -----------------------------------------------------
// 7. Gráfico de serie temporal
// -----------------------------------------------------

var graficoVH = ui.Chart.feature.groups({
  features: serie_vh_total,
  xProperty: 'mes',
  yProperty: 'area_agua_ha',
  seriesProperty: 'anio'
})
.setChartType('LineChart')
.setOptions({
  title: 'Área mensual de agua detectada con Sentinel-1 VH < -24 dB',
  hAxis: {
    title: 'Mes'
  },
  vAxis: {
    title: 'Área de agua (ha)'
  },
  lineWidth: 2,
  pointSize: 4
});

print(graficoVH);


// -----------------------------------------------------
// 8. Visualización de meses representativos
// -----------------------------------------------------

function visualizarMesVH(anio, mes, nombre) {
  var composite = compositeMensual(anio, mes);

  var agua = composite
    .select('VH')
    .lt(umbralVH)
    .selfMask();

  Map.addLayer(
    composite.select('VH'),
    {min: -30, max: -5},
    'VH ' + nombre,
    false
  );

  Map.addLayer(
    agua,
    {palette: ['blue']},
    'Agua VH < -24 dB ' + nombre,
    false
  );
}

visualizarMesVH(2019, 1, 'enero 2019');
visualizarMesVH(2019, 4, 'abril 2019');
visualizarMesVH(2021, 3, 'marzo 2021');
visualizarMesVH(2021, 7, 'julio 2021');
visualizarMesVH(2021, 12, 'diciembre 2021');


// -----------------------------------------------------
// 9. Exportar tabla final
// -----------------------------------------------------

Export.table.toDrive({
  collection: serie_vh_total,
  description: 'serie_final_agua_S1_VH_umbral_24_2019_2021',
  folder: 'GEE_TESIS_BLE',
  fileNamePrefix: 'serie_final_agua_S1_VH_umbral_24_2019_2021',
  fileFormat: 'CSV',
  selectors: [
    'anio',
    'fecha',
    'mes',
    'cantidad_imagenes',
    'polarizacion',
    'umbral_VH_dB',
    'area_agua_ha'
  ]
});
