  folder: 'GEE_TESIS_BLE',
  fileNamePrefix: 'frecuencia_agua_S1_2021',
  region: roi.geometry(),
  scale: escala,
  maxPixels: 1e13
});

Export.image.toDrive({
  image: frecuencia_total,
  description: 'frecuencia_agua_S1_2019_2021',
  folder: 'GEE_TESIS_BLE',
  fileNamePrefix: 'frecuencia_agua_S1_2019_2021',
  region: roi.geometry(),
  scale: escala,
  maxPixels: 1e13
});

Export.image.toDrive({
  image: diferencia_2021_2019,
  description: 'diferencia_frecuencia_agua_S1_2021_menos_2019',
  folder: 'GEE_TESIS_BLE',
  fileNamePrefix: 'diferencia_frecuencia_agua_S1_2021_menos_2019',
  region: roi.geometry(),
  scale: escala,
  maxPixels: 1e13
});


// -----------------------------------------------------
// 11. Exportar tabla de clases
// -----------------------------------------------------

Export.table.toDrive({
  collection: tabla_clases,
  description: 'area_clases_frecuencia_agua_S1_2019_2021',
  folder: 'GEE_TESIS_BLE',
  fileNamePrefix: 'area_clases_frecuencia_agua_S1_2019_2021',
  fileFormat: 'CSV',
  selectors: [
    'producto',
    'clase',
    'area_ha'
  ]
});
