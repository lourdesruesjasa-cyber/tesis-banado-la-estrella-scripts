  otsu_2019.aggregate_array('cantidad_imagenes')
);

print(
  'Cantidad de imágenes 2021 enero-diciembre:',
  otsu_2021.aggregate_array('cantidad_imagenes')
);


// -----------------------------------------------------
// 8. Visualizar máscaras de prueba
// -----------------------------------------------------

function visualizarOtsu(anio, mes, nombre) {
  var inicio = ee.Date.fromYMD(anio, mes, 1);
  var fin = inicio.advance(1, 'month');

  var coleccionMensual = s1.filterDate(inicio, fin);

  var composite = coleccionMensual
    .median()
    .clip(roi);

  var vv = composite.select('VV');

  var histograma = vv.reduceRegion({
    reducer: ee.Reducer.histogram({
      maxBuckets: 128,
      minBucketWidth: 0.1
    }),
    geometry: roi,
    scale: 10,
    maxPixels: 1e13,
    bestEffort: true,
    tileScale: 4
  });

  var histVV = ee.Dictionary(histograma.get('VV'));
  var umbral = otsu(histVV);

  var agua = vv
    .lt(umbral)
    .selfMask();

  Map.addLayer(
    vv,
    {min: -25, max: 0},
    'VV ' + nombre,
    false
  );

  Map.addLayer(
    agua,
    {palette: ['blue']},
    'Agua Otsu ' + nombre,
    false
  );

  print('Umbral Otsu ' + nombre + ':', umbral);
}


// Ejemplos para revisar visualmente
visualizarOtsu(2019, 1, 'enero 2019');
visualizarOtsu(2021, 1, 'enero 2021');


