// -----------------------------------------------------
// 1. Área de estudio
// -----------------------------------------------------

var roi = table;

Map.centerObject(roi, 11);

Map.addLayer(
  roi,
  {color: 'orange'},
  'Área de estudio - BLE'
);

// -----------------------------------------------------
// 2. Cargar Sentinel-1 GRD
// -----------------------------------------------------

var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(roi)
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .select(['VV', 'VH']);

// -----------------------------------------------------
// 3. Función para crear composite mensual
// -----------------------------------------------------

function compositeMensual(anio, mes) {
  var inicio = ee.Date.fromYMD(anio, mes, 1);
  var fin = inicio.advance(1, 'month');

  var coleccionMensual = s1.filterDate(inicio, fin);

  var composite = coleccionMensual
    .median()
    .clip(roi)
    .set('anio', anio)
    .set('mes', mes)
    .set('cantidad_imagenes', coleccionMensual.size());

  return composite;
}

// -----------------------------------------------------
// 4. Crear composites de prueba
// -----------------------------------------------------

var comp_ene_2019 = compositeMensual(2019, 1);
var comp_ene_2021 = compositeMensual(2021, 1);

// -----------------------------------------------------
// 5. Visualizar VV
// -----------------------------------------------------

Map.addLayer(
  comp_ene_2019.select('VV'),
  {min: -25, max: 0},
  'VV enero 2019'
);

Map.addLayer(
  comp_ene_2021.select('VV'),
  {min: -25, max: 0},
  'VV enero 2021',
  false
);

// -----------------------------------------------------
// 6. Umbral inicial de agua
// -----------------------------------------------------

var umbralVV = -17;

var agua_ene_2019 = comp_ene_2019
  .select('VV')
  .lt(umbralVV)
  .selfMask();

var agua_ene_2021 = comp_ene_2021
  .select('VV')
  .lt(umbralVV)
  .selfMask();

// -----------------------------------------------------
// 7. Visualizar máscaras de agua
// -----------------------------------------------------

Map.addLayer(
  agua_ene_2019,
  {palette: ['blue']},
  'Agua enero 2019 - VV < -17 dB'
);

Map.addLayer(
  agua_ene_2021,
  {palette: ['cyan']},
  'Agua enero 2021 - VV < -17 dB',
  false
);

// -----------------------------------------------------
// 8. Calcular área de agua en hectáreas
// -----------------------------------------------------

function calcularAreaAgua(maskAgua, nombre) {
  var areaPixel = ee.Image.pixelArea();

  var areaAgua = areaPixel
    .updateMask(maskAgua)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: roi,
      scale: 10,
      maxPixels: 1e13
    });

  var areaHa = ee.Number(areaAgua.get('area')).divide(10000);

  print(nombre + ' - Área de agua ha:', areaHa);
}

calcularAreaAgua(agua_ene_2019, 'Enero 2019');
calcularAreaAgua(agua_ene_2021, 'Enero 2021');
