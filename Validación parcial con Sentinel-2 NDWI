// =====================================================
// 11. Métricas de comparación S1 vs NDWI
// Validación parcial
// =====================================================

// Función para calcular área en hectáreas
function areaHa(mask) {
  var area = ee.Image.pixelArea()
    .updateMask(mask)
    .reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: roi,
      scale: 10,
      maxPixels: 1e13,
      tileScale: 4
    });

  return ee.Number(area.get('area')).divide(10000);
}


// Función para comparar dos máscaras
function compararS1NDWI(maskS1, maskNDWI, anio, mes, nombre) {

  // Convertir máscaras a binarias
  var s1_bin = maskS1.unmask(0).gt(0);
  var ndwi_bin = maskNDWI.unmask(0).gt(0);

  // Coincidencia: detectado por ambos métodos
  var coincidencia = s1_bin.and(ndwi_bin).selfMask();

  // Solo Sentinel-1
  var soloS1 = s1_bin.and(ndwi_bin.not()).selfMask();

  // Solo NDWI
  var soloNDWI = ndwi_bin.and(s1_bin.not()).selfMask();

  // Áreas
  var areaS1 = areaHa(s1_bin.selfMask());
  var areaNDWI = areaHa(ndwi_bin.selfMask());
  var areaCoincidente = areaHa(coincidencia);
  var areaSoloS1 = areaHa(soloS1);
  var areaSoloNDWI = areaHa(soloNDWI);

  var porcentajeCoincidenciaS1 = areaCoincidente
    .divide(areaS1)
    .multiply(100);

  // Visualización
  Map.addLayer(
    coincidencia,
    {palette: ['green']},
    'Coincidencia S1-NDWI ' + nombre,
    false
  );

  Map.addLayer(
    soloS1,
    {palette: ['blue']},
    'Solo S1 ' + nombre,
    false
  );

  Map.addLayer(
    soloNDWI,
    {palette: ['cyan']},
    'Solo NDWI ' + nombre,
    false
  );

  return ee.Feature(null, {
    'anio': anio,
    'mes': mes,
    'nombre': nombre,
    'area_S1_ha': areaS1,
    'area_NDWI_ha': areaNDWI,
    'area_coincidente_ha': areaCoincidente,
    'area_solo_S1_ha': areaSoloS1,
    'area_solo_NDWI_ha': areaSoloNDWI,
    'porcentaje_coincidencia_respecto_S1': porcentajeCoincidenciaS1
  });
}


