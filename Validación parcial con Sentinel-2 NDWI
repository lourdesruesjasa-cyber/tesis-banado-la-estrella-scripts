// -----------------------------------------------------
// 2. Cargar Sentinel-2 Surface Reflectance
// -----------------------------------------------------

var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(roi)
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 40));

print('Colección Sentinel-2 filtrada:', s2);
print('Cantidad total Sentinel-2:', s2.size());


// -----------------------------------------------------
// 3. Función para obtener composite mensual Sentinel-2
// -----------------------------------------------------

function compositeS2Mensual(anio, mes) {
  var inicio = ee.Date.fromYMD(anio, mes, 1);
  var fin = inicio.advance(1, 'month');

  var coleccionMensual = s2
    .filterDate(inicio, fin);

  print('Cantidad Sentinel-2 ' + anio + '-' + mes + ':', coleccionMensual.size());

  var composite = coleccionMensual
    .median()
    .clip(roi)
    .set('anio', anio)
    .set('mes', mes)
    .set('fecha', inicio.format('YYYY-MM'))
    .set('cantidad_imagenes', coleccionMensual.size());

  return composite;
}


// -----------------------------------------------------
// 4. Función NDWI
// -----------------------------------------------------

function calcularNDWI(imagen) {
  var ndwi = imagen
    .normalizedDifference(['B3', 'B8'])
    .rename('NDWI');

  return ndwi;
}


