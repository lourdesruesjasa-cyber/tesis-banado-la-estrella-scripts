// -----------------------------------------------------
// 10.1 Cargar Sentinel-1 para generar máscaras finales
// -----------------------------------------------------

var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(roi)
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .select(['VV', 'VH']);

var umbralVV = -17;


// -----------------------------------------------------
// 10.2 Función para generar composite mensual Sentinel-1
// -----------------------------------------------------

function compositeS1Mensual(anio, mes) {
  var inicio = ee.Date.fromYMD(anio, mes, 1);
  var fin = inicio.advance(1, 'month');

  var coleccionMensual = s1.filterDate(inicio, fin);

  var composite = coleccionMensual
    .median()
    .clip(roi)
    .set('anio', anio)
    .set('mes', mes)
    .set('cantidad_imagenes', coleccionMensual.size());

  return composite;
}


// -----------------------------------------------------
// 10.3 Función para máscara final Sentinel-1
// -----------------------------------------------------

function mascaraAguaS1(anio, mes) {
  var composite = compositeS1Mensual(anio, mes);

  var agua = composite
    .select('VV')
    .lt(umbralVV)
    .selfMask();

  return agua;
}


