// =====================================================
// TESIS BLE - Sentinel-1
// Script 07: Serie final de agua abierta con umbral fijo
// Años: 2019 y 2021
// Método principal: VV < -17 dB
// Autora: Lourdes Ruesjas Aebicher
// =====================================================


// -----------------------------------------------------
// 1. Área de estudio
// -----------------------------------------------------

var roi = table;

Map.centerObject(roi, 11);

Map.addLayer(
  roi,
  {color: 'orange'},
  'Área de estudio - BLE'
);


// -----------------------------------------------------
// 2. Parámetros principales
// -----------------------------------------------------

var umbralVV = -17;
var escala = 10;


// -----------------------------------------------------
// 3. Cargar colección Sentinel-1 GRD
// -----------------------------------------------------

var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(roi)
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .select(['VV', 'VH']);

print('Colección Sentinel-1 filtrada:', s1);
print('Cantidad total de imágenes Sentinel-1:', s1.size());


// -----------------------------------------------------
// 4. Función para crear composite mensual
// -----------------------------------------------------

function compositeMensual(anio, mes) {
  var inicio = ee.Date.fromYMD(anio, mes, 1);
  var fin = inicio.advance(1, 'month');

  var coleccionMensual = s1.filterDate(inicio, fin);

  var composite = coleccionMensual
    .median()
    .clip(roi)
    .set('anio', anio)
    .set('mes', mes)
    .set('fecha', inicio.format('YYYY-MM'))
    .set('cantidad_imagenes', coleccionMensual.size());

  return composite;
}


// -----------------------------------------------------
// 5. Función para calcular área mensual de agua
// -----------------------------------------------------

function calcularAreaMensual(anio) {
  var meses = ee.List.sequence(1, 12);

  var tabla = ee.FeatureCollection(
    meses.map(function(mes) {
      mes = ee.Number(mes);

      var composite = compositeMensual(anio, mes);
      var vv = composite.select('VV');

      var agua = vv
        .lt(umbralVV)
        .selfMask();

      var areaAgua = ee.Image.pixelArea()
        .updateMask(agua)
        .reduceRegion({
          reducer: ee.Reducer.sum(),
          geometry: roi,
          scale: escala,
          maxPixels: 1e13,
          tileScale: 4
        });

      var areaHa = ee.Number(areaAgua.get('area')).divide(10000);
      var areaKm2 = areaHa.divide(100);

      return ee.Feature(null, {
        'anio': anio,
        'mes': mes,
        'fecha': composite.get('fecha'),
        'cantidad_imagenes': composite.get('cantidad_imagenes'),
        'polarizacion': 'VV',
        'umbral_VV_dB': umbralVV,
        'area_agua_ha': areaHa,
        'area_agua_km2': areaKm2
      });
    })
  );

  return tabla;
}


// -----------------------------------------------------
// 6. Calcular áreas mensuales 2019 y 2021
// -----------------------------------------------------

var area_2019 = calcularAreaMensual(2019);
var area_2021 = calcularAreaMensual(2021);

var area_final = area_2019.merge(area_2021);

print('Serie mensual final Sentinel-1 2019:', area_2019);
print('Serie mensual final Sentinel-1 2021:', area_2021);
print('Serie mensual final Sentinel-1 2019 y 2021:', area_final);


// -----------------------------------------------------
// 7. Listas de control
// -----------------------------------------------------

print(
  'Áreas finales 2019 enero-diciembre (ha):',
  area_2019.aggregate_array('area_agua_ha')
);

print(
  'Áreas finales 2021 enero-diciembre (ha):',
  area_2021.aggregate_array('area_agua_ha')
);

print(
  'Cantidad de imágenes 2019 enero-diciembre:',
  area_2019.aggregate_array('cantidad_imagenes')
);

print(
  'Cantidad de imágenes 2021 enero-diciembre:',
  area_2021.aggregate_array('cantidad_imagenes')
);


// -----------------------------------------------------
// 8. Gráfico final
// -----------------------------------------------------

var graficoFinal = ui.Chart.feature.groups({
  features: area_final,
  xProperty: 'mes',
  yProperty: 'area_agua_ha',
  seriesProperty: 'anio'
})
.setChartType('LineChart')
.setOptions({
  title: 'Serie mensual de agua abierta - Sentinel-1 VV',
  hAxis: {
    title: 'Mes'
  },
  vAxis: {
    title: 'Área de agua abierta (ha)'
  },
  lineWidth: 2,
  pointSize: 5
});

print(graficoFinal);


// -----------------------------------------------------
// 9. Visualización de meses representativos
// -----------------------------------------------------

function visualizarMes(anio, mes, nombre) {
  var composite = compositeMensual(anio, mes);
  var vv = composite.select('VV');

  var agua = vv
    .lt(umbralVV)
    .selfMask();

  Map.addLayer(
    vv,
    {min: -25, max: 0},
    'VV ' + nombre,
    false
  );

  Map.addLayer(
    agua,
    {palette: ['blue']},
    'Agua final ' + nombre,
    false
  );
}

visualizarMes(2019, 1, 'enero 2019');
visualizarMes(2019, 3, 'marzo 2019');
visualizarMes(2021, 3, 'marzo 2021');
visualizarMes(2021, 7, 'julio 2021');
visualizarMes(2021, 12, 'diciembre 2021');


// -----------------------------------------------------
// 10. Exportar tabla final a Google Drive
// -----------------------------------------------------

Export.table.toDrive({
  collection: area_final,
  description: 'serie_final_agua_abierta_S1_VV_umbral_fijo_2019_2021',
  folder: 'GEE_TESIS_BLE',
  fileNamePrefix: 'serie_final_agua_abierta_S1_VV_umbral_fijo_2019_2021',
  fileFormat: 'CSV',
  selectors: [
    'anio',
    'fecha',
    'mes',
    'cantidad_imagenes',
    'polarizacion',
    'umbral_VV_dB',
    'area_agua_ha',
    'area_agua_km2'
  ]
});
